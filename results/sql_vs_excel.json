  "d_pairs_trade_fell_over_half_1913_to_1920": {
   "question": "Self-join: every exporter-importer pair whose trade fell by more than 50% from 1913 to 1920 (count, then the 10 largest falls)",
   "sql": "SELECT a.exporter, a.importer, ROUND(a.value_gbp) AS gbp_1913,\n       ROUND(b.value_gbp) AS gbp_1920, ROUND(a.value_gbp - b.value_gbp) AS fall\nFROM flows a JOIN flows b\n  ON a.exporter = b.exporter AND a.importer = b.importer\nWHERE a.year = 1913 AND b.year = 1920\n  AND a.value_gbp > 0 AND b.value_gbp < 0.5 * a.value_gbp\nORDER BY fall DESC LIMIT 10",
   "ms": 312.3,
   "columns": [
    "exporter",
    "importer",
    "gbp_1913",
    "gbp_1920",
    "fall"
   ],
